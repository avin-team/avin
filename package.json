{
  "name": "avin",
  "private": true,
  "workspaces": {
    "packages": [
      "apps/*",
      "packages/*",
      "e2e"
    ],
    "catalog": {
      "dotenv": "^17.4.2",
      "zod": "^4.4.3",
      "typescript": "^6.0.3",
      "@types/bun": "^1.3.14",
      "hono": "^4.12.31",
      "@orpc/server": "^1.14.8",
      "@orpc/openapi": "^1.14.8",
      "@orpc/zod": "^1.14.8",
      "better-auth": "1.6.24",
      "next-themes": "^0.4.6",
      "@orpc/client": "^1.14.8",
      "@supabase/supabase-js": "^2.111.0",
      "@types/react-dom": "^19.2.3",
      "lucide-react": "^1.25.0",
      "react": "^19.2.8",
      "react-dom": "^19.2.8",
      "sonner": "^2.0.7",
      "@types/react": "^19.2.17",
      "tailwindcss": "^4.3.3",
      "playwright": "^1.61.1",
      "vitest": "^4.1.10",
      "@orpc/tanstack-query": "^1.14.8",
      "@phosphor-icons/react": "^2.1.10",
      "@tailwindcss/vite": "^4.3.3",
      "@tanstack/react-form": "^1.33.2",
      "@tanstack/react-query": "^5.101.4",
      "@tanstack/react-query-devtools": "^5.101.4",
      "@tanstack/react-router": "^1.170.18",
      "@tanstack/react-router-devtools": "^1.167.0",
      "@tanstack/router-plugin": "^1.168.23",
      "@types/node": "^26.1.1",
      "@playwright/test": "^1.61.1",
      "otpauth": "^9.5.1",
      "@vitejs/plugin-react": "^6.0.4",
      "class-variance-authority": "^0.7.1",
      "date-fns": "^4.4.0",
      "drizzle-orm": "^0.45.2",
      "postcss": "^8.5.22",
      "qrcode.react": "^4.2.0",
      "recharts": "^3.8.1",
      "vite": "^8.1.5"
    }
  },
  "type": "module",
  "scripts": {
    "dev": "turbo dev",
    "build": "turbo build",
    "check-types": "turbo check-types",
    "test": "turbo test",
    "test:e2e": "bun run --cwd e2e e2e",
    "test:e2e:auth": "bun run --cwd e2e e2e:auth",
    "test:e2e:install": "bun run --cwd e2e install:browsers",
    "test:e2e:prod": "bun run --cwd e2e e2e:prod",
    "test:e2e:provider": "bun run --cwd e2e e2e:provider",
    "test:e2e:provision": "bun run --cwd e2e provision:accounts",
    "test:e2e:risk-report": "bun run --cwd e2e e2e:risk-report",
    "test:e2e:seller": "bun run --cwd e2e e2e:seller",
    "test:e2e:smoke": "bun run --cwd e2e e2e:smoke",
    "test:e2e:ui": "bun run --cwd e2e e2e:ui",
    "dev:web": "turbo -F web dev",
    "dev:server": "turbo -F server dev",
    "db:studio": "turbo -F @avin/db db:studio",
    "db:generate": "turbo -F @avin/db db:generate",
    "db:migrate": "turbo -F @avin/db db:migrate",
    "db:backup": "bun run --cwd packages/db db:backup",
    "db:clear": "bun run --cwd packages/db db:clear",
    "db:seed-seller-listings": "bun run --cwd packages/db db:seed-seller-listings",
    "db:backfill-risk-identifiers": "bun --env-file=apps/server/.env run scripts/risk-identifier-backfill.ts",
    "db:import-checkscam": "bun --env-file=apps/server/.env run scripts/checkscam-import/import.ts",
    "db:clean-checkscam": "bun --env-file=apps/server/.env run scripts/checkscam-import/import.ts --clean",
    "check": "ultracite check",
    "fix": "ultracite fix && bun run scripts/fix-tailwind-canonical.ts",
    "prepare": "lefthook install"
  },
  "dependencies": {
    "@avin/db": "workspace:*",
    "@avin/env": "workspace:*",
    "dotenv": "catalog:",
    "drizzle-orm": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@avin/config": "workspace:*",
    "@types/bun": "catalog:",
    "@workspace/eslint-plugin": "workspace:*",
    "eslint-plugin-github": "6.0.0",
    "lefthook": "^2.1.10",
    "oxfmt": "^0.60.0",
    "oxlint": "^1.75.0",
    "oxlint-plugin-react-doctor": "^0.7.1",
    "turbo": "^2.10.5",
    "typescript": "catalog:",
    "ultracite": "7.9.4",
    "vitest": "catalog:"
  },
  "packageManager": "bun@1.3.13"
}
