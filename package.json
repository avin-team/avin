{
  "name": "workspace",
  "private": true,
  "workspaces": {
    "packages": [
      "apps/*",
      "packages/*"
    ],
    "catalog": {
      "dotenv": "^17.4.2",
      "zod": "^4.4.3",
      "typescript": "^7.0.2",
      "@types/bun": "^1.3.4",
      "hono": "^4.12.31",
      "@orpc/server": "^1.14.8",
      "@orpc/openapi": "^1.14.8",
      "@orpc/zod": "^1.14.8",
      "better-auth": "1.6.24",
      "ai": "^7.0.34",
      "next-themes": "^0.4.6",
      "@orpc/client": "^1.14.8",
      "@types/react-dom": "^19.2.3",
      "lucide-react": "^1.25.0",
      "react": "^19.2.8",
      "react-dom": "^19.2.8",
      "sonner": "^2.0.7",
      "@types/react": "^19.2.17",
      "tailwindcss": "^4.3.3"
    }
  },
  "type": "module",
  "scripts": {
    "dev": "turbo dev",
    "build": "turbo build",
    "check-types": "turbo check-types",
    "dev:web": "turbo -F web dev",
    "dev:server": "turbo -F server dev",
    "db:push": "turbo -F @workspace/db db:push",
    "db:studio": "turbo -F @workspace/db db:studio",
    "db:generate": "turbo -F @workspace/db db:generate",
    "db:migrate": "turbo -F @workspace/db db:migrate",
    "db:start": "turbo -F @workspace/db db:start",
    "db:watch": "turbo -F @workspace/db db:watch",
    "db:stop": "turbo -F @workspace/db db:stop",
    "db:down": "turbo -F @workspace/db db:down",
    "check": "oxlint && oxfmt --write"
  },
  "dependencies": {
    "@workspace/env": "workspace:*",
    "dotenv": "^17.4.2",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/bun": "^1.3.14",
    "@workspace/config": "workspace:*",
    "oxfmt": "^0.60.0",
    "oxlint": "^1.75.0",
    "turbo": "^2.10.5",
    "typescript": "^7.0.2"
  },
  "packageManager": "bun@1.3.13"
}
