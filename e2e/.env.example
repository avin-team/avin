# Defaults to local and starts the API, web, and admin apps automatically.
E2E_TARGET=local

# Override these to test already-running local apps.
# E2E_BASE_URL=http://localhost:3001
# E2E_ADMIN_BASE_URL=http://localhost:5174
# E2E_API_BASE_URL=http://localhost:3000

# Dedicated, verified storefront account. Enables authenticated web projects.
# Generated automatically by: bun run test:e2e:provision
# E2E_USER_EMAIL=e2e-buyer@avin.local
# E2E_USER_PASSWORD=

# Dedicated, approved SELLER account with a profile. Enables listing E2E flows.
# Generated automatically by: bun run test:e2e:provision
# E2E_SELLER_EMAIL=e2e-seller@avin.test
# E2E_SELLER_PASSWORD=

# Dedicated account with Provider access for the registration E2E.
# Generated automatically by: bun run test:e2e:provision
# E2E_PROVIDER_EMAIL=e2e-provider@avin.test
# E2E_PROVIDER_PASSWORD=

# Local SePay configuration used to sign the synthetic webhook in Provider E2E.
# The actual bank transfer is never sent.
# E2E_SEPAY_BANK_ACCOUNT=
# E2E_SEPAY_WEBHOOK_SECRET=

# Dedicated ADMIN account with 2FA enabled. Enables authenticated admin projects.
# Store the raw Base32 TOTP secret, never a one-time six-digit code.
# E2E_ADMIN_EMAIL=e2e-admin@avin.local
# E2E_ADMIN_PASSWORD=
# E2E_ADMIN_TOTP_SECRET=

# Production requires an explicit HTTPS web URL and only runs @prod-safe tests.
# Authenticated projects are intentionally disabled for production.
# E2E_TARGET=prod
# E2E_BASE_URL=https://your-production-domain.example
# E2E_ADMIN_BASE_URL=https://admin.your-production-domain.example
# E2E_API_BASE_URL=https://api.your-production-domain.example
