{
  "name": "@avin/e2e",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "check-types": "tsc --noEmit",
    "e2e": "playwright test",
    "e2e:auth": "playwright test --grep @auth",
    "e2e:prod": "E2E_TARGET=prod playwright test",
    "e2e:provider": "playwright test --project=provider-authenticated",
    "e2e:risk-report": "playwright test --project=risk-report-authenticated",
    "e2e:seller": "playwright test --grep @seller",
    "e2e:smoke": "playwright test --grep @smoke",
    "e2e:ui": "playwright test --ui",
    "install:browsers": "playwright install chromium",
    "provision:accounts": "bun run scripts/provision-accounts.ts"
  },
  "dependencies": {
    "@avin/api": "workspace:*",
    "@avin/auth": "workspace:*",
    "@avin/db": "workspace:*",
    "dotenv": "catalog:",
    "drizzle-orm": "catalog:",
    "otpauth": "catalog:"
  },
  "devDependencies": {
    "@avin/config": "workspace:*",
    "@playwright/test": "catalog:",
    "@types/bun": "catalog:",
    "typescript": "catalog:"
  }
}
